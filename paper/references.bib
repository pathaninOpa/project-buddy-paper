@article{paper_4,
	author={Kumar, Sumit and Sharma, Prapti and Karnwal, Megha},
	booktitle={2024 2nd International Conference on Disruptive Technologies (ICDT)}, 
	title={AI -Based Health Management System for Elderly People}, 
	year={2024},
	volume={},
	number={},
	pages={1673-1678},
	abstract={This paper introduces an AI-powered healthcare system for the elderly, leveraging the advanced BERT algorithm. The platform utilizes BERT for mood tracking through journal writing, enabling nuanced assessment of mental health. Machine learning, based on contextual understanding, detects conditions like loneliness and depression with heightened accuracy, aiding in early detection. To combat social isolation, virtual companionship and access to support groups are introduced. In medication management, BERT ensures adherence, sending reminders and detecting potential interactions. This integrated approach revolutionizes elderly care by addressing physical, mental, and social well-being. The system aims to enhance the overall quality of life for the aging population, promoting independence, health, and belonging. With a rising global aging population, this AI solution is poised to make a substantial impact on senior care, demonstrating promising outcomes in accuracy and efficiency.},
	keywords={Sentiment analysis;Ethics;Privacy;Reviews;Sociology;Medical services;Aging;AI-powered healthcare Assessment;Mood Tracking;ML Algorithms;BERT;Virtual Support Groups;Medication Management},
	doi={10.1109/ICDT61202.2024.10488983},
	ISSN={},
	month={March}
}

@article{paper_5,
	author={Raotole, Atharv and Shirodkar, Sailee Sanjay and Shukla, Rahul and Sisodia, Jignesh and Devadkar, Kailas},
	booktitle={2024 4th International Conference on Intelligent Technologies (CONIT)}, 
	title={WellBe: An Intelligent Elderly Care and Well-Being Monitoring System Using Deep Learning}, 
	year={2024},
	volume={},
	number={},
	pages={1-6},
	abstract={Deep Learning refers to a subset of Machine Learning that utilizes deep neural networks to simulate the complex decision-making process of the human brain. In recent years, DL has made remarkable progress in addressing multiple unique challenges faced by most elderly individuals. While there have been significant contributions to independent systems catered for the elderly, there is the existence of an overall integrated AI platform that unifies the use of individual modules for an optimized solution. This paper introduces “WellBe,” an innovative AI system that encompasses an alarm-based fall detection component, a facial emotion recognition (FER) system and a built-in personalized chatbot all under a user-friendly website. The novelty of the work extends beyond the aforementioned components, owing to the implementation of an optimized FER system able to handle wrinkles and changes in skin texture, thereby tailored exclusively for the elderly demographic. The system leverages a custom feature extraction module, fusing facial and wrinkle features, in addition to extending a convolutional neural network (CNN) architecture for accurate emotion classification, achieving promising performance with precision, recall, and F1-scores of 0.87, 0.91, and 0.89 for the “Happy” (one of the predicted emotions) class, respectively. The fall detection component, on the other hand, utilizes a pre-trained YOLOv7 Pose model for the real-time identification of falls, sitting at a performance accuracy of 95.3%. Finally, the personalized chatbot is implemented using a rule-based approach enhanced with the Jaccard similarity algorithm, to facilitate prompt assistance and a sense of companionship to the end user. Overall, the integration of these components into a cohesive website offers a comprehensive solution for enhancing the quality of life for elderly individuals living alone, addressing loneliness, safety, and overall well-being.},
	keywords={Deep learning;Accuracy;Feature extraction;Chatbots;Skin;Real-time systems;Safety;Elderly Care;Fall Detection;Emotion Recognition;Convolutional Neural Networks;YOLOv7;Jaccard Similarity},
	doi={10.1109/CONIT61985.2024.10626766},
	ISSN={},
	month={June
	}
}

@article{paper_6,
    author={Gu, Jiawei and Jiang, Xuhui and Shi, Zhichao and Tan, Hexiang and Zhai, Xuehao and Xu, Chengjin and Li, Wei and Shen, Yinghan and Ma, Shengjie and Liu, Honghao and others},
    title={A Survey on LLM-as-a-Judge},
    journal={arXiv preprint arXiv:2411.15594},
    year={2024},
    url={https://arxiv.org/abs/2411.15594},
    abstract={Large Language Models (LLMs) have demonstrated exceptional capabilities across various tasks, but evaluating their outputs remains a significant challenge due to the open-ended nature of generation. This paper provides a comprehensive survey on the emerging "LLM-as-a-Judge" paradigm, where advanced LLMs act as evaluators for other models. The survey categorizes methodologies into pairwise comparisons, single-response grading, and reference-based evaluation. It highlights the advantages of scalability, cost-efficiency, and consistency compared to human evaluation, while also addressing critical challenges such as position bias, verbosity bias, and self-preference. This work serves as a foundational reference for adopting automated evaluation pipelines in conversational AI development.}
}

